{
  "name": "dsh-script-library",
  "version": "0.1.0",
  "description": "A script library for DeepSeek Harness: auto-captures PTC/run_code script outputs into a two-tier library (staging + formal index) and provides a sidebar UI with a pending-count badge and management panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "script-library",
    "ptc",
    "run_code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/dsh-script-library.git"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "bundle": "node scripts/build.js",
    "watch": "node scripts/build.js --watch"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  }
}